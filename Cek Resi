html[data-theme="light"] #accountExpiryLink { color: rgb(14, 116, 144); }

html[data-theme="light"] .expiry-modal-action { background: rgb(185, 28, 28); color: rgb(255, 255, 255); }

html[data-theme="light"] .expiry-modal-action:hover { background: rgb(153, 27, 27); }

