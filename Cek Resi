.expiry-modal-message, .expiry-modal-contact { margin: 0px; color: rgb(229, 231, 235); font-size: 14px; line-height: 1.6; }

.expiry-modal-contact { margin-top: 5px; }

#accountExpiryLink { color: rgb(103, 232, 249); text-decoration: underline; text-underline-offset: 3px; font-weight: 750; }

#accountExpiryContactFallback { font-weight: 750; }

.expiry-modal-action { display: block; width: 100%; margin-top: 20px; padding: 12px 14px; border: 0px; border-radius: 10px; background: rgb(220, 38, 38); color: rgb(255, 255, 255); font-style: inherit; font-variant: inherit; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-weight: 800; cursor: pointer; transition: background 0.15s, filter 0.15s; }

.expiry-modal-action:hover { background: rgb(185, 28, 28); }

.expiry-modal-action.is-quota-ended { background: rgb(55, 65, 81); color: rgb(255, 255, 255); }

.expiry-modal-action.is-quota-ended:hover { background: rgb(75, 85, 99); }

.expiry-modal-action:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }

html[data-theme="light"] .expiry-modal { background: rgb(255, 255, 255); color: rgb(23, 32, 51); border-color: rgb(254, 202, 202); box-shadow: rgba(15, 23, 42, 0.22) 0px 24px 70px; }

html[data-theme="light"] .expiry-modal::backdrop { background: rgba(15, 23, 42, 0.48); }

html[data-theme="light"] #accountExpiryTitle { color: rgb(185, 28, 28); }

