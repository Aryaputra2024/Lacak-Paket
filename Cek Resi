.expiry-modal { width: min(448px, 100% - 2rem); max-width: 448px; padding: 0px; overflow: visible; background: rgb(23, 24, 28); color: rgb(248, 250, 252); border: 1px solid rgb(127, 29, 29); border-radius: 18px; box-shadow: rgba(0, 0, 0, 0.32) 0px 24px 70px; }

